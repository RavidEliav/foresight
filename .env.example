# Copy to .env for local runs. On Railway, set the same names as service variables
# (identical values in the main and dev environments). Never commit real values.

OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
# true = no LLM calls (tests, CI, offline development)
MOCK_LLM=false
# Required to start a pipeline run from the app; leave empty to disable runs
RUN_PASSCODE=

# CrewAI cloud tracing/telemetry (off: they slow runs and send data out)
CREWAI_TRACING_ENABLED=false
CREWAI_DISABLE_TELEMETRY=true
OTEL_SDK_DISABLED=true

# Supabase run registry (optional; without it the app reads the run folders).
# Session pooler URLs, one Supabase project per Railway environment; the push script sets
# SUPABASE_DB_URL in each Railway environment. Set SUPABASE_DB_URL here only if your network
# allows Postgres connections (port 5432).
SUPABASE_DB_URL_DEV=
SUPABASE_DB_URL_MAIN=
